{
  "name": "model_selector_enter_switches",
  "description": "Enter on an expandable card switches directly with the default model (only Right opens the drawer)",
  "setup": {
    "cols": 120,
    "rows": 40
  },
  "actions": [
    { "type": "type", "text": "/model" },
    { "type": "press", "key": "Enter" },
    { "type": "assert", "check": "dialog_contains", "text": "Switch Model" },
    { "type": "press", "key": "Enter" }
  ],
  "assertions": [
    { "check": "output_contains", "text": "Model switched to: gpt-4o" },
    { "check": "not_contains", "text": "Configuration updated!" }
  ]
}
