{
  "name": "multi_line_input",
  "description": "Type multiple lines in the input area and submit",
  "setup": {
    "cols": 80,
    "rows": 24,
    "mock_response": "Multi-line received"
  },
  "actions": [
    { "type": "type", "text": "line one" },
    { "type": "press", "key": "Enter" },
    { "type": "type", "text": "line two" },
    { "type": "press", "key": "Enter" },
    { "type": "press", "key": "Enter" }
  ],
  "assertions": [
    { "check": "output_contains", "text": "[user]" },
    { "check": "output_contains", "text": "line one" },
    { "check": "output_contains", "text": "line two" },
    { "check": "output_contains", "text": "Multi-line received" },
    { "check": "input_contains", "text": "Input" }
  ]
}
