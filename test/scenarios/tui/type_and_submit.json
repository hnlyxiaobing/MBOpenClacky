{
  "name": "type_and_submit",
  "description": "Type a message and press Enter to submit",
  "setup": {
    "cols": 80,
    "rows": 24,
    "mock_response": "Hello from eval mock!"
  },
  "actions": [
    { "type": "type", "text": "hello world" },
    { "type": "screenshot" },
    { "type": "press", "key": "Enter" },
    { "type": "screenshot" }
  ],
  "assertions": [
    { "check": "output_contains", "text": "[user]" },
    { "check": "output_contains", "text": "hello world" },
    { "check": "output_contains", "text": "eval mock" },
    { "check": "input_contains", "text": "Input" }
  ]
}
