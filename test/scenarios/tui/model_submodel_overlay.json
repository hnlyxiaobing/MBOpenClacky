{
  "name": "model_submodel_overlay",
  "description": "Selecting a provider sub-model in the /model drawer pins it as the session overlay",
  "setup": {
    "cols": 120,
    "rows": 40
  },
  "actions": [
    { "type": "type", "text": "/model" },
    { "type": "press", "key": "Enter" },
    { "type": "press", "key": "j" },
    { "type": "press", "key": "Right" },
    { "type": "press", "key": "j" },
    { "type": "press", "key": "Enter" }
  ],
  "assertions": [
    { "check": "output_contains", "text": "Model switched to: claude-sonnet-4-6 (sub-model: claude-opus-4-8)" }
  ]
}
