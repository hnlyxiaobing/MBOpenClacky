{
  "name": "static_js_accessible",
  "description": "Verify app.js bundle is served correctly from the fork front-end skeleton",
  "setup": {
    "api_key": null,
    "model_configured": false
  },
  "steps": [
    { "method": "GET", "path": "/app.js" }
  ],
  "assertions": [
    { "check": "status_eq", "status": 200 },
    { "check": "header_contains", "name": "Content-Type", "text": "javascript" },
    { "check": "body_length_gt", "min": 100 }
  ]
}
