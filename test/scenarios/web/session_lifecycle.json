{
  "name": "session_lifecycle",
  "description": "Create a session and verify it is listed by GET /api/sessions (SessionSummary uses `id`, not `session_id`; delete/restore are covered by the Layer 9 journey web_session_lifecycle)",
  "setup": {
    "api_key": null,
    "model_configured": true
  },
  "steps": [
    {
      "method": "POST",
      "path": "/api/sessions",
      "body": "{\"name\":\"Lifecycle Test\"}",
      "assertions": [
        { "check": "status_eq", "status": 201 },
        { "check": "body_contains", "text": "\"id\"" }
      ]
    },
    {
      "method": "GET",
      "path": "/api/sessions",
      "assertions": [
        { "check": "status_eq", "status": 200 },
        { "check": "body_contains", "text": "sessions" },
        { "check": "body_contains", "text": "Lifecycle Test" }
      ]
    }
  ],
  "assertions": [
    { "check": "status_eq", "status": 200 },
    { "check": "body_contains", "text": "sessions" }
  ]
}
