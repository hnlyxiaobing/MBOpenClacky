        { "check": "status_eq", "status": 200 }
      ]
    },
    {
      "method": "GET",
      "path": "/api/billing/summary",
      "assertions": [
        { "check": "status_eq", "status": 200 }
      ]
    },
    {
      "method": "GET",
      "path": "/api/config/models",
      "assertions": [
        { "check": "status_eq", "status": 200 }
      ]
    }
  ]
