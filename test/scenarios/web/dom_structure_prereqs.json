{
  "name": "dom_structure_prereqs",
  "description": "Verify index.html contains structural elements needed by the SPA skeleton",
  "setup": {
    "api_key": null,
    "model_configured": false
  },
  "steps": [
    { "method": "GET", "path": "/" }
  ],
  "assertions": [
    { "check": "status_eq", "status": 200 },
    { "check": "body_contains", "text": "<html" },
    { "check": "body_contains", "text": "<div" },
    { "check": "body_contains", "text": "app.js" },
    { "check": "body_contains", "text": "app.css" },
    { "check": "body_contains", "text": "id=\"top-header\"" },
    { "check": "body_contains", "text": "id=\"sidebar\"" },
    { "check": "body_length_gt", "min": 100 }
  ]
}
