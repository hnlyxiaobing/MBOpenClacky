{
  "id": "cli_model_switch",
  "title": "CLI --model flag switches the active model",
  "area": "cli",
  "description": "用户通过 --model 指定非默认模型运行一次性任务：mock upstream 收到请求的模型名与指定模型一致，stdout 输出成功。",
  "timeout_ms": 120000,
  "permission_mode": "auto_approve",
  "seed": [],
  "llm_steps": [
    { "response": { "type": "content", "text": "Hello from mock-model-b!", "usage": { "prompt_tokens": 40, "completion_tokens": 8 } } }
  ],
  "phases": [
    { "name": "run_with_model", "steps": [
      { "action": "spawn_cli", "message": "hello", "json": true, "mode": "auto_approve", "extra_args": ["--model", "mock-model-b"] },
      { "action": "wait_child", "timeout_ms": 90000 }
    ] }
  ],
  "assertions": [
    { "type": "exit_code", "code": 0 },
    { "type": "stdout_json_path_eq", "path": "status", "value": "\"Success\"" },
    { "type": "mock_request_count", "min": 1, "max": 1 }
  ]
}
