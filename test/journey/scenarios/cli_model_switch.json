{
  "id": "cli_model_switch",
  "title": "CLI --model flag selects the active model",
  "area": "cli",
  "description": "User passes --model to select a specific model from config; mock upstream receives the request and stdout shows success.",
  "timeout_ms": 120000,
  "permission_mode": "auto_approve",
  "seed": [],
  "llm_steps": [
    {
      "response": {
        "type": "content",
        "text": "Hello from mock-model!",
        "usage": { "prompt_tokens": 40, "completion_tokens": 8 }
      }
    }
  ],
  "phases": [
    {
      "name": "run_with_model",
      "steps": [
        {
          "action": "spawn_cli",
          "message": "hello",
          "json": true,
          "mode": "auto_approve",
          "extra_args": ["--model", "mock-model"]
        },
        {
          "action": "wait_child",
          "timeout_ms": 90000
        }
      ]
    }
  ],
  "assertions": [
    { "type": "exit_code", "code": 0 },
    { "type": "stdout_json_path_eq", "path": "status", "value": "\"Success\"" },
    { "type": "mock_request_count", "min": 1, "max": 1 }
  ]
}
