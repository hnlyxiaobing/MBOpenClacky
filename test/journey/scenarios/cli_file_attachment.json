{
  "id": "cli_file_attachment",
  "title": "CLI --file flag accepts file attachment",
  "area": "cli",
  "description": "User passes --file with a seed file; CLI accepts the flag and runs successfully without error.",
  "timeout_ms": 120000,
  "permission_mode": "auto_approve",
  "seed": [
    {
      "path": "test.txt",
      "content": "Hello World from test file"
    }
  ],
  "llm_steps": [
    {
      "response": {
        "type": "content",
        "text": "I can see the file.",
        "usage": { "prompt_tokens": 100, "completion_tokens": 15 }
      }
    }
  ],
  "phases": [
    {
      "name": "run_with_file",
      "steps": [
        {
          "action": "spawn_cli",
          "message": "What is in this file?",
          "json": true,
          "mode": "auto_approve",
          "extra_args": ["--file", "{workspace}/test.txt"]
        },
        {
          "action": "wait_child",
          "timeout_ms": 90000
        }
      ]
    }
  ],
  "assertions": [
    { "type": "exit_code", "code": 0 },
    { "type": "stdout_json_path_eq", "path": "status", "value": "\"Success\"" },
    { "type": "mock_request_count", "min": 1, "max": 1 }
  ]
}
