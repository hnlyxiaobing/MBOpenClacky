{
  "id": "cli_agent_profile_switch",
  "title": "CLI --agent flag selects agent profile",
  "area": "cli",
  "description": "User passes --agent to select a specific agent profile; CLI loads the profile and runs successfully.",
  "timeout_ms": 120000,
  "permission_mode": "auto_approve",
  "seed": [],
  "llm_steps": [
    {
      "response": {
        "type": "content",
        "text": "Hello from coding agent!",
        "usage": { "prompt_tokens": 50, "completion_tokens": 10 }
      }
    },
    {
      "response": {
        "type": "content",
        "text": "Hello again!",
        "usage": { "prompt_tokens": 50, "completion_tokens": 10 }
      }
    }
  ],
  "phases": [
    {
      "name": "run_with_default_agent",
      "steps": [
        {
          "action": "spawn_cli",
          "message": "hello",
          "json": true,
          "mode": "auto_approve"
        },
        {
          "action": "wait_child",
          "timeout_ms": 90000
        }
      ]
    },
    {
      "name": "run_with_coding_agent",
      "steps": [
        {
          "action": "spawn_cli",
          "message": "hello",
          "json": true,
          "mode": "auto_approve",
          "extra_args": ["--agent", "coding"]
        },
        {
          "action": "wait_child",
          "timeout_ms": 90000
        }
      ]
    }
  ],
  "assertions": [
    { "type": "exit_code", "code": 0 },
    { "type": "stdout_json_path_eq", "path": "status", "value": "\"Success\"" },
    { "type": "mock_request_count", "min": 2, "max": 2 }
  ]
}
