{
  "id": "tui_undo_operation",
  "title": "TUI undo reverses a file write tool call",
  "area": "tui",
  "description": "用户让 Agent 创建一个文件（通过 mock 脚本化的 tool_call），然后用 /undo 撤销操作：文件被恢复（删除），验证 Time Machine 的撤销链路。",
  "timeout_ms": 120000,
  "permission_mode": "auto_approve",
  "llm_steps": [
    { "response": { "type": "tool_calls", "tool_calls": [
      { "id": "call_undo_1", "name": "write", "arguments": { "path": "undo_test.txt", "content": "temporary content" } }
    ] },
    { "response": { "type": "content", "text": "已创建 undo_test.txt。", "usage": { "prompt_tokens": 80, "completion_tokens": 10 } } }
  ],
  "phases": [
    { "name": "create_file", "steps": [
      { "action": "tui_new", "cols": 120, "rows": 40 },
      { "action": "tui_type", "text": "创建文件 undo_test.txt" },
      { "action": "tui_send", "timeout_ms": 60000 },
      { "action": "assert", "assertions": [
        { "type": "file_exists", "path": "{workspace}/undo_test.txt" }
      ] }
    ] },
    { "name": "undo", "steps": [
      { "action": "tui_type", "text": "/undo" },
      { "action": "tui_press", "key": "Enter" },
      { "action": "assert", "assertions": [
        { "type": "file_missing", "path": "{workspace}/undo_test.txt" }
      ] }
    ] }
  ],
  "assertions": [
    { "type": "status_contains", "text": "idle" }
  ]
}
