{
  "id": "pure-fn-test",
  "goal": "加一个纯函数测试：写入 .mbt 测试块并确认 grep 能检索到它",
  "steps": [
    {
      "tool": "write",
      "args": {
        "path": "{sandbox}/harness_demo_wbtest.mbt",
        "content": "///|\ntest \"doubling is pure\" {\n  assert_eq(double(2), 4)\n}\n"
      }
    },
    {
      "tool": "grep",
      "args": { "pattern": "doubling is pure", "path": "{sandbox}" },
      "expect_contains": "doubling is pure"
    }
  ],
  "checks": [
    { "kind": "file_exists", "path": "{sandbox}/harness_demo_wbtest.mbt" },
    {
      "kind": "file_contains",
      "path": "{sandbox}/harness_demo_wbtest.mbt",
      "text": "assert_eq(double(2), 4)"
    }
  ]
}