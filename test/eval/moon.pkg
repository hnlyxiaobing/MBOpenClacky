import {
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "hnlyxiaobing/MBOpenClacky/lib/tool",
  "hnlyxiaobing/MBOpenClacky/lib/agent",
  "hnlyxiaobing/MBOpenClacky/lib/client",
  "hnlyxiaobing/MBOpenClacky/lib/config",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
}

// The model-driven layer (live_harness.mbt) additionally drives the real
// lib/agent ReAct loop against the model in the task config; it reuses the
// mock LLM server from test/e2e to prove the wiring without a network.
// The async tests additionally need the `moonbitlang/async` runtime, and
// `@env` is used by the capability mock.
import {
  "hnlyxiaobing/MBOpenClacky/test/e2e",
  "moonbitlang/core/env",
  "moonbitlang/async",
} for "wbtest"

// The deterministic tool harness drives the real lib/tool registry, which is
// native-only (PTY / shell FFI).

supported_targets = "native"
