import {
  "moonbitlang/core/string",
  "moonbitlang/core/strconv",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "hnlyxiaobing/MBOpenClacky/lib/agent",
  "hnlyxiaobing/MBOpenClacky/lib/client",
  "hnlyxiaobing/MBOpenClacky/lib/config",
  "hnlyxiaobing/MBOpenClacky/lib/errors",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
  "moonbitlang/core/random",
  "moonbitlang/core/json",
  "moonbit-community/tty",
  "moonbit-community/tty/input" @tty/input,
  "moonbit-community/tty/color",
  "moonbitlang/async",
  "moonbitlang/async/io" @async/io,
  "moonbitlang/async/aqueue",
  "moonbitlang/x/fs",
}

warnings = "-6"

supported_targets = "native"

options(
  "native-stub": [ "console_cp_native.c" ],
  link: { "native": { "cc-link-flags": "-lcurl" } },
)
