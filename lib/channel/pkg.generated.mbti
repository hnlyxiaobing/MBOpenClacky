pub fn WsMessage::not_equal(Self, Self) -> Bool
pub fn WsMessage::to_repr(Self) -> @debug.Repr

// Type aliases

// Traits
pub(open) trait Adapter {
  fn platform_id(Self) -> Platform
  fn start(Self, (ChannelEvent) -> Unit) -> Result[Unit, ChannelError]
  fn stop(Self) -> Result[Unit, ChannelError]
  async fn send_text(Self, String, String, String?) -> Result[SendResult, ChannelError]
  async fn update_message(Self, String, String, String) -> Result[Unit, ChannelError]
  fn supports_message_updates(Self) -> Bool
  fn validate_config(Self) -> Array[String]
}
