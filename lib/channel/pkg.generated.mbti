pub(all) struct WeComAdapter {
  corp_id : String
  agent_id : String
  secret : String
  token : String?
  encoding_aes_key : String?
  mut is_running : Bool
  mut message_callback : ((ChannelEvent) -> Unit)?
  ws_state : WeComWsState?
  access_token_cache : TokenCache
}
pub fn WeComAdapter::new(ChannelConfig) -> Result[Self, ChannelError]
pub fn WeComAdapter::parse_event(Json) -> Result[ChannelEvent, ChannelError]
pub fn WeComAdapter::platform_id(Self) -> Platform
pub async fn WeComAdapter::send_text(Self, String, String, String?) -> Result[SendResult, ChannelError]
pub fn WeComAdapter::start(Self, (ChannelEvent) -> Unit) -> Result[Unit, ChannelError]
pub fn WeComAdapter::stop(Self) -> Result[Unit, ChannelError]
pub fn WeComAdapter::supports_message_updates(Self) -> Bool
pub async fn WeComAdapter::update_message(Self, String, String, String) -> Result[Unit, ChannelError]
pub fn WeComAdapter::validate_config(Self) -> Array[String]
pub impl Adapter for WeComAdapter

