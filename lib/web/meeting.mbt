///| Meeting data model and persistence store.

///| Meetings are special sessions for structured discussions with transcript

///| and summary generation capabilities.

///|
/// Status of a meeting.
pub(all) enum MeetingStatus {
  /// Meeting is currently in progress.
  Active
  /// Meeting has been ended.
  Ended
} derive(Eq, Show, Debug)

///|
pub fn MeetingStatus::to_string_value(self : MeetingStatus) -> String {
  match self {
    Active => "active"
    Ended => "ended"
  }
}

///|
pub fn meeting_status_from_string(s : String) -> MeetingStatus {
  match s {
    "ended" => Ended
    _ => Active
  }
}

///|
/// A single transcript entry in a meeting.
pub(all) struct TranscriptEntry {
  /// Author/speaker name.
  speaker : String
  /// Message content.
  content : String
  /// Timestamp in milliseconds since epoch.
  timestamp : Int64
} derive(Eq, Debug)

///|
impl ToJson for TranscriptEntry with fn to_json(self) {
  Json::object({
    "speaker": self.speaker.to_json(),
    "content": self.content.to_json(),
    "timestamp": self.timestamp.to_json(),
  })
}

///|
impl FromJson for TranscriptEntry with fn from_json(json, path) {
  match json {
    Object(obj) => {
      let speaker = match obj.get("speaker") {
        Some(String(s)) => s
        _ =>
          raise @json.JsonDecodeError(
            (path, "TranscriptEntry: missing speaker"),
          )
      }
      let content = match obj.get("content") {
        Some(String(s)) => s
        _ =>
          raise @json.JsonDecodeError(
            (path, "TranscriptEntry: missing content"),
          )
      }
      let timestamp = match obj.get("timestamp") {
        Some(Number(n, ..)) => n.to_int64()
        _ => 0L
      }
      { speaker, content, timestamp }
    }
    _ => raise @json.JsonDecodeError((path, "TranscriptEntry: expected object"))
  }
}

///|
/// Structured meeting summary (generated by meeting-summarizer skill).
pub(all) struct MeetingSummary {
  /// High-level overview of the meeting.
  overview : String
  /// Key decisions made during the meeting.
  key_decisions : Array[String]
  /// Action items with assignees.
  action_items : Array[String]
  /// Main discussion points.
  discussion_points : Array[String]
  /// When the summary was generated (ms since epoch).
  generated_at : Int64
} derive(Eq, Debug)

///|
impl ToJson for MeetingSummary with fn to_json(self) {
  Json::object({
    "overview": self.overview.to_json(),
    "key_decisions": self.key_decisions.to_json(),
    "action_items": self.action_items.to_json(),
    "discussion_points": self.discussion_points.to_json(),
    "generated_at": self.generated_at.to_json(),
  })
}

///|
impl FromJson for MeetingSummary with fn from_json(json, path) {
  match json {
    Object(obj) => {
      let overview = match obj.get("overview") {
        Some(String(s)) => s
        _ => ""
      }
      let key_decisions = parse_str_arr(obj, "key_decisions")
      let action_items = parse_str_arr(obj, "action_items")
      let discussion_points = parse_str_arr(obj, "discussion_points")
      let generated_at = match obj.get("generated_at") {
        Some(Number(n, ..)) => n.to_int64()
        _ => 0L
      }
      { overview, key_decisions, action_items, discussion_points, generated_at }
    }
    _ => raise @json.JsonDecodeError((path, "MeetingSummary: expected object"))
  }
}

///|
/// Helper to parse transcript entries from JSON array.
fn parse_transcript_arr(json_opt : Json?) -> Array[TranscriptEntry] {
  match json_opt {
    Some(Array(arr)) => {
      let entries : Array[TranscriptEntry] = []
      for item in arr {
        let entry : TranscriptEntry = @json.from_json(item) catch {
          _ => { speaker: "", content: "", timestamp: 0L }
        }
        entries.push(entry)
      }
      entries
    }
    _ => []
  }
}

///|
/// Helper to optionally parse a MeetingSummary from a JSON value.
fn parse_summary_opt(json_opt : Json?) -> MeetingSummary? {
  match json_opt {
    Some(j) => {
      let s : MeetingSummary = @json.from_json(j) catch {
        _ =>
          {
            overview: "",
            key_decisions: [],
            action_items: [],
            discussion_points: [],
            generated_at: 0L,
          }
      }
      Some(s)
    }
    None => None
  }
}

///|
/// Helper to parse a string array from a JSON object.
fn parse_str_arr(obj : Map[String, Json], key : String) -> Array[String] {
  match obj.get(key) {
    Some(Array(arr)) => {
      let result : Array[String] = []
      for item in arr {
        match item {
          String(s) => result.push(s)
          _ => ()
        }
      }
      result
    }
    _ => []
  }
}

///|
/// Meeting data model — represents a single meeting session.
pub(all) struct Meeting {
  /// Unique meeting identifier.
  id : String
  /// Meeting title.
  title : String
  /// Current meeting status.
  mut status : MeetingStatus
  /// Associated agent session ID (optional).
  session_id : String?
  /// Meeting participants.
  participants : Array[String]
  /// Meeting transcript entries.
  transcript : Array[TranscriptEntry]
  /// Generated summary (None until summarized).
  mut summary : MeetingSummary?
  /// Creation timestamp (ms since epoch).
  created_at : Int64
  /// End timestamp (ms since epoch, 0 if still active).
  mut ended_at : Int64
} derive(Eq, Debug)

///|
impl ToJson for Meeting with fn to_json(self) {
  let summary_json : Json = match self.summary {
    Some(s) => s.to_json()
    None => Json::null()
  }
  let session_json : Json = match self.session_id {
    Some(s) => s.to_json()
    None => Json::null()
  }
  Json::object({
    "id": self.id.to_json(),
    "title": self.title.to_json(),
    "status": self.status.to_string_value().to_json(),
    "session_id": session_json,
    "participants": self.participants.to_json(),
    "transcript": self.transcript.to_json(),
    "summary": summary_json,
    "created_at": self.created_at.to_json(),
    "ended_at": self.ended_at.to_json(),
  })
}

///|
impl FromJson for Meeting with fn from_json(json, path) {
  match json {
    Object(obj) => {
      let id = match obj.get("id") {
        Some(String(s)) => s
        _ => raise @json.JsonDecodeError((path, "Meeting: missing id"))
      }
      let title = match obj.get("title") {
        Some(String(s)) => s
        _ => ""
      }
      let status = match obj.get("status") {
        Some(String(s)) => meeting_status_from_string(s)
        _ => MeetingStatus::Active
      }
      let session_id = match obj.get("session_id") {
        Some(String(s)) => Some(s)
        _ => None
      }
      let participants = parse_str_arr(obj, "participants")
      let transcript = parse_transcript_arr(obj.get("transcript"))
      let summary = parse_summary_opt(obj.get("summary"))
      let created_at = match obj.get("created_at") {
        Some(Number(n, ..)) => n.to_int64()
        _ => 0L
      }
      let ended_at = match obj.get("ended_at") {
        Some(Number(n, ..)) => n.to_int64()
        _ => 0L
      }
      {
        id,
        title,
        status,
        session_id,
        participants,
        transcript,
        summary,
        created_at,
        ended_at,
      }
    }
    _ => raise @json.JsonDecodeError((path, "Meeting: expected object"))
  }
}

// ── Meeting Store ─────────────────────────────────────────────────────

///|
/// Get the meetings directory, creating it if necessary.
fn meetings_dir() -> String? {
  match @utils.home_dir() {
    Some(home) => {
      let dir = @path.Path::join(home, @path.Path(".mbopenclacky/meetings")).to_string()
      @utils.ensure_dir(dir)
      Some(dir)
    }
    None => None
  }
}

///|
/// Generate a unique meeting ID.
pub fn generate_meeting_id() -> String {
  "m_" + @agent.current_time_ms().to_string()
}

///|
/// Save a meeting to disk as a JSON file.
pub fn save_meeting(meeting : Meeting) -> Result[Unit, String] {
  let dir = match meetings_dir() {
    Some(d) => d
    None => return Err("Cannot determine meetings directory")
  }
  let path = @path.Path::join(dir, @path.Path(meeting.id + ".json")).to_string()
  @fs.write_string_to_file(path, meeting.to_json().to_string()) catch {
    e => return Err("Failed to save meeting: \{e}")
  }
  Ok(())
}

///|
/// Load a meeting from disk by ID.
pub fn load_meeting(id : String) -> Meeting? {
  let dir = match meetings_dir() {
    Some(d) => d
    None => return None
  }
  let path = @path.Path::join(dir, @path.Path(id + ".json")).to_string()
  let content = @fs.read_file_to_string(path) catch { _ => return None }
  let json = @json.parse(content) catch { _ => return None }
  let meeting : Meeting = @json.from_json(json) catch { _ => return None }
  Some(meeting)
}

///|
/// List all meetings, sorted by created_at descending (newest first).
pub fn list_meetings() -> Array[Meeting] {
  let dir = match meetings_dir() {
    Some(d) => d
    None => return []
  }
  let filenames = @fs.read_dir(dir) catch { _ => return [] }
  let meetings : Array[Meeting] = []
  for name in filenames {
    if name.has_suffix(".json") {
      let id = name[:name.length() - 5].to_owned()
      match load_meeting(id) {
        Some(m) => meetings.push(m)
        None => ()
      }
    }
  }
  // Sort by created_at descending (newest first)
  meetings.sort_by((a, b) => {
    if a.created_at > b.created_at {
      -1
    } else if a.created_at < b.created_at {
      1
    } else {
      0
    }
  })
  meetings
}

///|
/// Delete a meeting from disk.
pub fn delete_meeting(id : String) -> Unit {
  let dir_opt = meetings_dir()
  match dir_opt {
    Some(dir) => {
      let path = @path.Path::join(dir, @path.Path(id + ".json")).to_string()
      let _ = @fs.remove_file(path) catch { _ => () }
    }
    None => ()
  }
}
