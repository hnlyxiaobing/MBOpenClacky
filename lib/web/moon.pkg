import {
  "moonbitlang/core/debug",
  "moonbitlang/core/string",
  "moonbitlang/core/env",
  "hnlyxiaobing/MBOpenClacky/lib/agent",
  "hnlyxiaobing/MBOpenClacky/lib/config",
  "hnlyxiaobing/MBOpenClacky/lib/client",
  "hnlyxiaobing/MBOpenClacky/lib/message",
  "hnlyxiaobing/MBOpenClacky/lib/errors",
  "hnlyxiaobing/MBOpenClacky/lib/tool",
  "hnlyxiaobing/MBOpenClacky/lib/billing",
  "hnlyxiaobing/MBOpenClacky/lib/channel",
  "hnlyxiaobing/MBOpenClacky/lib/server",
  "hnlyxiaobing/MBOpenClacky/lib/skill",
  "hnlyxiaobing/MBOpenClacky/lib/brand",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
  "hnlyxiaobing/MBOpenClacky/lib/extension",
  "hnlyxiaobing/MBOpenClacky/lib/media",
  "hnlyxiaobing/MBOpenClacky/lib/vision",
  "hnlyxiaobing/MBOpenClacky/lib/mcp",
  "hnlyxiaobing/MBOpenClacky/lib/zip",
  "hnlyxiaobing/MBOpenClacky/lib/web/middleware" @mid,
  "hnlyxiaobing/MBOpenClacky/lib/web/broadcast",
  "hnlyxiaobing/MBOpenClacky/lib/web/protocol",
  "hnlyxiaobing/crescent",
  "hnlyxiaobing/crescent/core",
  "hnlyxiaobing/crescent/cors",
  "hnlyxiaobing/crescent/websocket" @ws,
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/codec/base64",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/process",
  "moonbitlang/async/socket",
}

supported_targets = "native"

options(
  // 该包无 fn main，不能声明 link 选项（新构建规划器会把带 link 的包当作
  // 可执行目标链接，产生 undefined reference to main）。
  // -lcrypto 由 moon.mod 的 pre-build 脚本（build-script.py）通过链接配置
  // 机制提供（lib/brand 的 crypto_native.c 引用 OpenSSL EVP_*/RAND_bytes）。
  // Windows: BCrypt auto-linked via #pragma comment in crypto_native.c.
)
