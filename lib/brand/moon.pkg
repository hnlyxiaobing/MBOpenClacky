import {
  "bobzhang/toml",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
  "moonbitlang/x/crypto",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
}

options(
  "native-stub": [ "crypto_native.c", "brand_stubs.c" ],
  // Windows: BCrypt + WinHTTP auto-linked via #pragma comment in crypto_native.c
  // Linux/macOS: -lcrypto (OpenSSL AES-256-GCM/RAND_bytes) + -lcurl (HTTP GET)
  link: { "native": { "cc-link-flags": "-lcrypto -lcurl" } },
)
