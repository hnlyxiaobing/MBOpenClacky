import {
  "bobzhang/toml",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
  "moonbitlang/x/crypto",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
}

options(
  "native-stub": [ "crypto_native.c", "brand_stubs.c" ],
  // Windows: BCrypt is auto-linked via #pragma comment(lib,"bcrypt.lib") in crypto_native.c (MSVC/mingw)
  // Linux/macOS: uncomment the line below to link OpenSSL libcrypto when building on Linux
  // link: { "native": { "cc-link-flags": "-lcrypto" } },
)
