import {
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "hnlyxiaobing/toml",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/crypto",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
}

// 该包无 fn main，不能声明 link 选项（新构建规划器会把带 link 的包当作
// 可执行目标链接，产生 undefined reference to main）。
// -lcrypto 由 moon.mod 的 pre-build 脚本（build-script.py）通过链接配置
// 机制提供，见 build-script.py 头部注释。
pkgtype(kind: "library")

options(
  "native-stub": [ "crypto_native.c", "brand_stubs.c" ],
  // Windows: BCrypt auto-linked via #pragma comment in crypto_native.c
  // Linux/macOS: -lcrypto (OpenSSL AES-256-GCM/RAND_bytes) 由 build-script.py 注入
)
