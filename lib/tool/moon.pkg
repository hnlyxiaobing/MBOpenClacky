import {
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
  "moonbitlang/x/codec/base64",
  "hnlyxiaobing/MBOpenClacky/lib/mcp",
  "hnlyxiaobing/MBOpenClacky/lib/client",
  "moonbitlang/async",
}

options(
  "native-stub": [ "tool_stubs.c" ],
  targets: {
    "terminal_exec.mbt": [ "native" ],
    "terminal_exec_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
  // lib.client/http_native.c requires libcurl on Linux/macOS.
  link: { "native": { "cc-link-flags": "-lcurl" } },
)
