warnings = "-29"

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/strconv",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/codec/base64",
  "hnlyxiaobing/MBOpenClacky/lib/mcp",
  "hnlyxiaobing/MBOpenClacky/lib/client",
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbit-community/pty",
}

supported_targets = "native"

options(
  targets: {
    "terminal_exec.mbt": [ "native" ],
    "terminal_exec_wasm.mbt": [ "wasm", "wasm-gc" ],
    "pty.mbt": [ "native" ],
    "pty_marker.mbt": [ "native" ],
    "pty_session.mbt": [ "native" ],
    "pty_session_wasm.mbt": [ "wasm", "wasm-gc" ],
    "shell_exec.mbt": [ "native" ],
    "shell_exec_wbtest.mbt": [ "native" ],
  },
)
