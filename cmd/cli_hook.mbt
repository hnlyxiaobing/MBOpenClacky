///|
/// CLI handlers for the `hook` subcommand group:
///   hook new <name>     - create a new hook descriptor
///   hook verify [path]  - verify hook descriptors parse correctly
///
/// Reuses the existing `load_shell_hooks` parser (hook_loader.mbt) for verify,
/// keeping the CLI surface and runtime loading surface consistent.

///|
/// Dispatch the `hook` subcommand. `hook_value` is the nested SimpleValue
/// produced by clap for the `hook` subcommand; its `.subcmd` field names the
/// concrete action (new/verify).
pub fn handle_hook(hook_value : @clap.SimpleValue) -> Unit {
  let action = match hook_value.subcmd {
    Some(sub) => sub
    None => {
      print_hook_help()
      return
    }
  }
  match action.name {
    "new" =>
      match get_hook_named_arg(action, "name") {
        Some(name) => handle_hook_new(action, name)
        None => {
          println("[hook] error: 'new' requires a <name> argument")
          println(
            "Usage: mbopenclacky hook new <name> [--event <e>] [--command <cmd>]",
          )
        }
      }
    "verify" => handle_hook_verify(get_hook_named_arg(action, "path"))
    _ => {
      println("[hook] unknown subcommand: " + action.name)
      print_hook_help()
    }
  }
}

///|
/// Read a named argument from a nested SimpleValue.
fn get_hook_named_arg(value : @clap.SimpleValue, name : String) -> String? {
  match value.args.get(name) {
    Some(arr) =>
      match arr.get(0) {
        Some(v) => Some(v)
        None => None
      }
    None => None
  }
}

///|
/// Print the `hook` subcommand help text.
fn print_hook_help() -> Unit {
  println("Usage: mbopenclacky hook <action> [args]")
  println("")
  println("Actions:")
  println("  new <name>                 Create a new hook descriptor")
  println(
    "  verify [path]              Verify hook descriptors parse correctly",
  )
}

///|
/// `hook new` — scaffold a new hook descriptor (.toml) in the hook dir.
fn handle_hook_new(action : @clap.SimpleValue, name : String) -> Unit {
  if name.is_empty() {
    println("[hook] error: name cannot be empty")
    return
  }
  let event = get_hook_named_arg(action, "event").unwrap_or("session_start")
  let command = get_hook_named_arg(action, "command").unwrap_or("")

  let hook_dir = match @utils.home_dir() {
    Some(home) =>
      @path.Path::join(home, @path.Path(".clacky/hooks")).to_string()
    None => ".clacky/hooks"
  }
  @utils.ensure_dir(hook_dir)

  let filename = name.replace(old=" ", new="_") + ".toml"
  let path = @path.Path::join(hook_dir, @path.Path(filename)).to_string()
  if @fs.path_exists(path) {
    println("[hook] error: hook already exists at " + path)
    return
  }

  let content = gen_hook_descriptor(name, event, command)
  @fs.write_string_to_file(path, content) catch {
    e => println("[hook] create failed: " + @debug.to_string(e))
  }
  println("[hook] created " + path)
}

///|
/// `hook verify [path]` — load the hook dir and report parse validity.
fn handle_hook_verify(path_opt : String?) -> Unit {
  let hooks = load_shell_hooks(config_dir=path_opt)
  if hooks.is_empty() {
    println("[hook] no hook descriptors found (nothing to verify)")
    return
  }
  println("[hook] verified \{hooks.length()} hook(s):")
  for h in hooks {
    let state = if h.enabled { "enabled" } else { "disabled" }
    println("  - \{h.name} (event: \{h.event}, \{state})")
  }
}

///|
/// Generate a TOML-like hook descriptor (matching the simple parser in
/// hook_loader.mbt, which expects a [[hook]] section).
fn gen_hook_descriptor(
  name : String,
  event : String,
  command : String,
) -> String {
  let mut buf = "# Hook descriptor generated by `mbopenclacky hook new`\n"
  buf = buf + "[[hook]]\n"
  buf = buf + "name = \"" + name + "\"\n"
  buf = buf + "event = \"" + event + "\"\n"
  if !command.is_empty() {
    buf = buf + "command = \"" + command + "\"\n"
  }
  buf = buf + "enabled = true\n"
  buf
}
