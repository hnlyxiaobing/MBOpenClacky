import {
  "moonbitlang/core/string",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/strconv",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/core/hashset",
  "moonbitlang/x/sys",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "TheWaWaR/clap",
  "hnlyxiaobing/MBOpenClacky/lib/config",
  "hnlyxiaobing/MBOpenClacky/lib/agent",
  "hnlyxiaobing/MBOpenClacky/lib/billing",
  "hnlyxiaobing/MBOpenClacky/lib/brand",
  "hnlyxiaobing/MBOpenClacky/lib/client",
  "hnlyxiaobing/MBOpenClacky/lib/errors",
  "hnlyxiaobing/MBOpenClacky/lib/extension",
  "hnlyxiaobing/MBOpenClacky/lib/skill",
  "hnlyxiaobing/MBOpenClacky/lib/tool",
  "hnlyxiaobing/MBOpenClacky/lib/tui",
  "hnlyxiaobing/MBOpenClacky/lib/web",
  "hnlyxiaobing/MBOpenClacky/lib/utils",
  "hnlyxiaobing/MBOpenClacky/test/eval",
  "hnlyxiaobing/MBOpenClacky/test/benchmark",
  "hnlyxiaobing/MBOpenClacky/test/tui" @test_tui,
  "hnlyxiaobing/MBOpenClacky/test/web" @test_web,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  // The brand package's C stubs (crypto_native.c) call OpenSSL (libcrypto)
  // for AES-256-GCM and RAND_bytes on Linux/macOS. Windows uses BCrypt
  // (auto-linked via #pragma comment in crypto_native.c).
  //
  // -lcrypto is injected by build-script.js (moon.mod prebuild) for non-Windows
  // platforms only; declaring it unconditionally here would make MSVC look for
  // crypto.lib and fail with LNK1181 on Windows (no OpenSSL installed).
  // See build-script.js header for the propagation mechanism.
)
