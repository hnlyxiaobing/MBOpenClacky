# MoonBit 构建产物
_build/
.mooncakes/
.moon/


# 源码缓存（mooncakes 下载源）
.repos/

# Qoder IDE 配置
.qoder/

# openCode 配置
.omo

# 已生成 IDE 辅助文件
*.mbti
*.generated.*
# P0-1 公共 API 闸门：lib/ 与 cmd/ 各包的接口文件必须入库，CI 以
# `moon info` + `git diff --exit-code` 校验公共 API 变更是否随代码提交。
# vendor/、test/ 与其他生成物继续忽略。
!lib/pkg.generated.mbti
!lib/**/pkg.generated.mbti
!cmd/pkg.generated.mbti
!cmd/**/pkg.generated.mbti
*check_output*.txt
.check*.txt

# 构建生成产物
logs/
# Evolver 进化状态
memory/

# 系统文件
.DS_Store
Thumbs.db
nul


# 备份与临时文件
*.log
moon.mod.bak
.gitcommit_msg.txt
_review_diff.txt
_bak_tui_v1/
.test_auto_creator/
.test_web_compare/
.git_panel_output.tmp
trace.json


# vendor 补丁副本的隔离区（被禁用的 mbtpdf 示例/测试包，不参与构建）
vendor_disabled/
